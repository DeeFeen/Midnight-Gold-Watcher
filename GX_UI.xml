<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

    <!--
        Virtual templates derived from official Blizzard templates
        (wow-ui-source reference used during development):

        - PortraitFrameFlatTemplate
                modern panel with portrait + title container + close button,
                flat panel background (no heavy rock texture).
                (Blizzard_SharedXML/Mainline/SharedUIPanelTemplates.xml)
        - DialogBorderTemplate & DialogHeaderTemplate
                rounded-corner dialog border and DiamondMetal header bar.
                Used as a child "BG" frame, exactly like Blizzard's own
                CreateChannelPopup dialog.
                (Blizzard_SharedXML/Shared/Dialog/DialogTemplates.xml)
        - UIPanelCloseButtonDefaultAnchors
                standard 24x24 close button (top-right corner).
                (Blizzard_SharedXML/Mainline/SharedUIPanelTemplates.xml)
        - InputBoxTemplate
                modern edit box visual + behaviour.
                (Blizzard_SharedXML/Shared/InputBox/InputBoxTemplates.xml)
    -->

    <!-- Main frame: total account gold display (compact) -->
    <Frame name="GXMainFrameTemplate" mixin="GXMainFrameMixin"
           inherits="PortraitFrameFlatTemplate" virtual="true"
           toplevel="true" enableMouse="true" movable="true"
           hidden="true" frameStrata="DIALOG">
        <Size x="250" y="112"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>

    <!-- Secondary frame: copyable export popup -->
    <Frame name="GXExportFrameTemplate" mixin="GXExportFrameMixin"
           virtual="true"
           toplevel="true" enableMouse="true" movable="true"
           hidden="true" frameStrata="DIALOG">
        <Size x="520" y="150"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
        <Frames>
            <!-- Rounded dialog border fills the whole frame (NineSlice). -->
            <Frame parentKey="BG" inherits="DialogBorderTemplate"/>
            <Button parentKey="CloseButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
            <Frame parentKey="Header" inherits="DialogHeaderTemplate"/>
            <EditBox parentKey="EditBox" inherits="InputBoxTemplate"
                     autoFocus="false" multiLine="false">
                <Size x="470" y="28"/>
                <Anchors>
                    <Anchor point="TOP" y="-48"/>
                </Anchors>
            </EditBox>
        </Frames>
    </Frame>

    <!-- Minimap button: circular coin icon orbiting Minimap -->
    <Button name="GXMinimapButtonTemplate" virtual="true"
            frameStrata="MEDIUM" frameLevel="8" hidden="true">
        <Size x="32" y="32"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" file="Interface\Minimap\UI-Minimap-Background">
                    <Size x="25" y="25"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\Icons\INV_Misc_Coin_05">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Border" file="Interface\Minimap\MiniMap-TrackingBorder">
                    <Size x="54" y="54"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD"/>
    </Button>

</Ui>